# Dependencies
node_modules/

# Rust build artifacts
target/

# Next.js build output
.next/
apps/web/.next/
apps/web/out/

# Environment files with real secrets. .env.example is the only one meant
# to be committed, and it never carries a real value.
.env
.env.*
.env.local
.env.*.local
!.env.example

# Vercel project link and local build output
.vercel/

# Auto-generated by Next.js's agentRules feature (disabled in
# apps/web/next.config.ts); regenerates locally, never meant to be
# committed.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# OS cruft
.DS_Store

# Editor
.vscode/
.idea/
