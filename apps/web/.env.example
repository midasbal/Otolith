# Copy this file to .env.local and adjust if needed. Never commit .env.local.
#
# Stellar testnet endpoints the app reads from. Both default to the
# standard public testnet endpoints in code, so these only need to be set
# to point at a different network or a private endpoint.

# Horizon URL, used for classic account and balance reads.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC URL, used for contract state reads.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployer keypair that sponsors smart-account deploy fees on behalf of a
# new user and submits keeper rebalances. It never becomes a signer on any
# user's smart account. Server-only on purpose, no NEXT_PUBLIC_ prefix, so
# Next.js never exposes it to the browser. Put the real secret key (S...)
# in .env.local only, never here and never in any committed file.
DEPLOYER_SECRET_KEY=

# Whether the deploy sponsor (POST /api/deployer) blocks requests that are
# not one of the four operations it exists for: creating a smart account,
# funding it, and installing or revoking its rebalance policy. Off unless
# set to "true" or "1": every request is still checked and the verdict is
# written to the log (search for "deployer-sponsor"), but none is blocked.
# Turn it on once the log shows every normal flow passing.
DEPLOYER_ENFORCE=

# The least XLM the deployer/keeper key may hold before it stops sponsoring
# deploys and submitting rebalances (both answer 503 until it is topped up).
# This is the backstop against the key being drained: whatever else goes
# wrong, it cannot spend below this. A rebalance costs a fraction of an XLM,
# so the default of 100 leaves hundreds of them. Unset or not a number: 100.
DEPLOYER_MIN_BALANCE_XLM=100

# Upstash Redis (REST), used to rate limit POST /api/deployer, POST
# /api/rebalance and GET /api/rebalance per client IP. Both are server-only.
# Optional: with either missing, or Upstash unreachable, requests are allowed
# rather than blocked, so the limit never stands in the way of account
# creation or rebalancing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
