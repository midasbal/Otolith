# Copy this file to .env.local and adjust if needed. Never commit .env.local.
#
# Stellar testnet endpoints the app reads from. Both default to the
# standard public testnet endpoints in code, so these only need to be set
# to point at a different network or a private endpoint.

# Horizon URL, used for classic account and balance reads.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC URL, used for contract state reads.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployer keypair that sponsors smart-account deploy fees on behalf of a
# new user, submits keeper rebalances, and (see lib/server/anchor.ts)
# also acts as the lira-deposit relay: the classic SEP-10 identity and
# deposit recipient for the TR mock anchor, since a passkey smart account
# has no classic key of its own. It never becomes a signer on any user's
# smart account. Server-only on purpose, no NEXT_PUBLIC_ prefix, so
# Next.js never exposes it to the browser. Put the real secret key (S...)
# in .env.local only, never here and never in any committed file. The
# relay role additionally needs: a funded XLM balance, a trustline to the
# anchor's USDC (classic asset USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5),
# and a reserve balance of the portfolio's own USDC
# (CB3TLW74NBIOT3BUWOZ3TUM6RFDF6A4GVIRUQRQZABG5KPOUL4JJOV2F) to forward
# 1:1 against deposits. All three are one-time setup on this key, not
# something the app configures at runtime.
DEPLOYER_SECRET_KEY=
